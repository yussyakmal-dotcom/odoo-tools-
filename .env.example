# Docker Compose configuration only. Never commit actual secrets.
# For localhost HTTP, leave Secure cookie disabled; enable behind HTTPS.
BOM_COOKIE_SECURE=false
BOM_SESSION_TTL_HOURS=8

# REQUIRED to save Odoo credentials. Generate once; keep unchanged across restarts.
# Example generator (after docker compose build api):
# docker compose run --rm --no-deps api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOM_ENCRYPTION_KEY=

# By default *.odoo.com is allowed. List exact extra hostnames for custom domains.
# Example: BOM_ODOO_ALLOWED_HOSTS=erp.example.com,odoo.mycompany.id
BOM_ODOO_ALLOWED_HOSTS=
